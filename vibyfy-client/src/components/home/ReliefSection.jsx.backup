import { useNavigate } from "react-router-dom";
import { HeartHandshake, ArrowRight } from "lucide-react";
import ReliefCard from "../cards/ReliefCard";

const ReliefSection = ({ songs = [] }) => {
  const navigate = useNavigate();
  const reliefCategories = [
    {
      id: 1,
      title: "Stress Relief",
      icon: "😌",
      moods: ["relief", "relax", "calm"],
    },
    {
      id: 2,
      title: "Feeling Sad",
      icon: "💙",
      moods: ["sad", "melancholy"],
    },
    {
      id: 3,
      title: "Feeling Angry",
      icon: "🔥",
      moods: ["angry", "rage"],
    },
    {
      id: 4,
      title: "Peaceful Mind",
      icon: "🌿",
      moods: ["peace", "meditation", "devotional"],
    },
  ];

  return (
    <section className="space-y-6">

      {/* Header */}
      <div className="flex items-center justify-between">

        <div className="flex items-center gap-3">

          <HeartHandshake
            size={30}
            className="text-green-400"
          />

          <h2 className="text-2xl md:text-3xl font-bold">
            Relief Zone
          </h2>

        </div>

        <button
          onClick={() => navigate("/relief")}
          className="flex items-center gap-2 text-purple-400 hover:text-purple-300 transition"
        >

          View All

          <ArrowRight size={18} />

        </button>

      </div>

      {songs.length === 0 ? (
        <div className="bg-slate-900 rounded-2xl p-10 text-center">

          <h3 className="text-xl font-semibold">
            No Relief Songs
          </h3>

          <p className="text-slate-400 mt-2">
            Upload songs with mood tags.
          </p>

        </div>
      ) : (
        <div
          className="
            grid
            grid-cols-1
            sm:grid-cols-2
            xl:grid-cols-4
            gap-6
          "
        >
          {reliefCategories.map((relief) => (
            <ReliefCard
              key={relief.id}
              relief={relief}
              songs={songs}
            />
          ))}
        </div>
      )}

    </section>
  );
};

export default ReliefSection;