# VIBYFY Backend Environment Configuration
PORT=5000

# Spotify Web API Credentials (Client Credentials Flow)
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/auth/spotify/callback

# ── Analytics API ──────────────────────────────────────────────────────────────
# MongoDB URI — required for persistent analytics storage.
# If not set, the server uses an in-memory fallback (data lost on restart).
# Create a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/vibyfy_analytics?retryWrites=true&w=majority

# Firebase Project ID (from your Firebase console → Project settings → General)
# Used to validate Firebase JWT tokens on management endpoints.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Comma-separated allowed CORS origins for the analytics ingestion endpoint.
# Add your P2 tracker app domain here (no trailing slash).
# Example: https://p2-tracker.com,https://your-p2-domain.vercel.app
ANALYTICS_ALLOWED_ORIGINS=https://your-p2-domain.com
